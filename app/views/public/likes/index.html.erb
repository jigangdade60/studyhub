<div class="container py-3" style="max-width: 700px;">

  <!-- タイトル -->
  <div class="mb-3">
    <h5 class="fw-bold mb-0">いいね一覧</h5>
  </div>

  <% if @liked_posts.empty? %>
    <div class="bg-white border rounded-4 p-4 text-muted text-center">
      まだいいねした投稿はありません
    </div>
  <% else %>
    <%= render partial: "public/posts/card", collection: @liked_posts, as: :post, locals: { body_length: 100 } %>
  <% end %>
</div>
<div class="mt-0 mb-5 d-flex justify-content-center">
  <%= paginate @liked_posts %>
</div>